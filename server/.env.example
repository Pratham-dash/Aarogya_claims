# --- Required ---
# Local MongoDB:  mongodb://127.0.0.1:27017/aarogya_claims
# Atlas:          mongodb+srv://<user>:<password>@<cluster>.mongodb.net/aarogya_claims?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/aarogya_claims
# Any long random string (e.g. `openssl rand -hex 32`)
JWT_SECRET=replace-me-with-a-long-random-string

# --- Optional (defaults shown) ---
PORT=5000
NODE_ENV=development
JWT_EXPIRES_IN=8h
# Comma-separated list of allowed browser origins (CORS)
CLIENT_URL=http://localhost:5173
# Create demo users + demo claims on boot when the users collection is empty
SEED_ON_START=true
# MongoDB connection pool (explicit upper/lower bound)
DB_POOL_MAX=20
DB_POOL_MIN=2
# Max upload size in MB
MAX_UPLOAD_MB=10
